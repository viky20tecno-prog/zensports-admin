# ============================================================
#  ZenSports Admin — Variables de entorno (Next.js)
#  Copia como .env.local — NUNCA subas valores reales a GitHub
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Service role (admin, no expira)

# ── Auth admin panel ──────────────────────────────────────────
ADMIN_JWT_SECRET=                 # String aleatorio seguro (min 32 chars)

# ── Comunicación interna con la API ──────────────────────────
API_URL=https://api.zensports.zenpra.ai
INTERNAL_API_SECRET=              # Mismo valor que en la API

# ── URLs públicas ─────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=https://admin.zensports.zenpra.ai

# ── Email — Zoho SMTP ────────────────────────────────────────
ZOHO_SMTP_USER=hola@zenpra.ai
ZOHO_SMTP_PASS=                   # Contraseña SMTP de Zoho
EMAIL_FROM=ZenSports <noreply@zenpra.ai>
